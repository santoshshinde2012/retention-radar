# Copy to .env locally if you like (not required; env vars work as-is).
# Never commit real secrets — this project uses synthetic data only.

# Data path: synthetic | lakehouse | auto (prefer external/ when present)
CHURN_DATA_SOURCE=synthetic

# Scale / Optuna (defaults match published seed-42 ladder: 5000 / 20)
N_USERS=5000
N_OPTUNA_TRIALS=20

# Package import path when not using editable install:
#   export PYTHONPATH="$(pwd)/src"
# Prefer: pip install -e .
# PYTHONPATH=src
