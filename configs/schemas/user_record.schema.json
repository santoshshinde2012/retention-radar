{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.local/schemas/user_record.schema.json",
  "title": "AI Platform Churn — Inference User Record",
  "description": "Single-record inference payload (no churned label). Aligns with FEATURE_COLUMNS in src/config.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "user_id",
    "user_name",
    "days_since_signup",
    "sessions_last_7d",
    "sessions_last_30d",
    "avg_session_minutes",
    "models_used_count",
    "api_calls_last_30d",
    "tokens_consumed_last_30d",
    "tools_used_count",
    "failed_requests_rate",
    "support_tickets_last_90d",
    "plan_tier",
    "payment_failures_last_90d",
    "feature_adoption_score",
    "nps_score",
    "last_active_days_ago",
    "weekend_usage_ratio",
    "engagement_trend",
    "spend_usd_last_30d",
    "days_until_renewal",
    "agent_runs_last_30d",
    "ide_plugin_sessions_last_30d",
    "seat_utilization"
  ],
  "properties": {
    "user_id": { "type": "string", "minLength": 1 },
    "user_name": { "type": "string", "minLength": 1 },
    "days_since_signup": { "type": "number", "minimum": 1, "maximum": 2000 },
    "sessions_last_7d": { "type": "number", "minimum": 0, "maximum": 60 },
    "sessions_last_30d": { "type": "number", "minimum": 0, "maximum": 200 },
    "avg_session_minutes": { "type": "number", "minimum": 0.5, "maximum": 240 },
    "models_used_count": { "type": "number", "minimum": 0, "maximum": 30 },
    "api_calls_last_30d": { "type": "number", "minimum": 0, "maximum": 100000 },
    "tokens_consumed_last_30d": { "type": "number", "minimum": 0, "maximum": 50000000 },
    "tools_used_count": { "type": "number", "minimum": 0, "maximum": 40 },
    "failed_requests_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "support_tickets_last_90d": { "type": "number", "minimum": 0, "maximum": 50 },
    "plan_tier": {
      "type": "string",
      "enum": ["free", "starter", "pro", "enterprise"]
    },
    "payment_failures_last_90d": { "type": "number", "minimum": 0, "maximum": 20 },
    "feature_adoption_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "nps_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "last_active_days_ago": { "type": "number", "minimum": 0, "maximum": 365 },
    "weekend_usage_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "engagement_trend": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "sessions_last_7d / max(1, sessions_last_30d/4); ≈1 stable, <1 cooling"
    },
    "spend_usd_last_30d": { "type": "number", "minimum": 0, "maximum": 100000 },
    "days_until_renewal": { "type": "number", "minimum": 0, "maximum": 730 },
    "agent_runs_last_30d": { "type": "number", "minimum": 0, "maximum": 5000 },
    "ide_plugin_sessions_last_30d": { "type": "number", "minimum": 0, "maximum": 500 },
    "seat_utilization": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
